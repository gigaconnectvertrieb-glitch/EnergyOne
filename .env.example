# Render Environment Variables — niemals ins Git.
# Werte nur im Render-Dashboard.

NODE_VERSION=22
NODE_ENV=production
VITE_AUTH_ENABLED=true

# Render Postgres → Internal Database URL
DATABASE_URL=postgres://USER:PASS@HOST/e1

# Öffentliche URL der App (nach dem ersten Deploy setzen, später Custom Domain)
BETTER_AUTH_URL=https://e1-direktvertrieb.onrender.com
BETTER_AUTH_SECRET=mindestens-32-zufaellige-zeichen

# Dateien (Gebiet-Uploads) — Render Disk mounten
UPLOAD_DIR=/var/data/uploads

# Google Workspace — Domain-wide Delegation, kein Passwort
GOOGLE_WORKSPACE_CLIENT_EMAIL=portal@….iam.gserviceaccount.com
GOOGLE_WORKSPACE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n…\n-----END PRIVATE KEY-----\n"
GOOGLE_WORKSPACE_ADMIN_EMAIL=orhan.salo@e1direktvertrieb.de
GOOGLE_WORKSPACE_CUSTOMER_ID=

# DocuSign — Unterschrift per E-Mail (optional, Tablet geht ohne)
DOCUSIGN_INTEGRATION_KEY=
DOCUSIGN_USER_ID=
DOCUSIGN_ACCOUNT_ID=
DOCUSIGN_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n…\n-----END RSA PRIVATE KEY-----\n"
DOCUSIGN_OAUTH_BASE=https://account-d.docusign.com
DOCUSIGN_CONNECT_SECRET=

